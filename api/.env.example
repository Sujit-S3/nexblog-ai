# --- Required ---
MONGO=mongodb://127.0.0.1:27017/mern-blog
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# --- AI providers (optional, but at least one is needed for real AI generation; ---
# --- without any, AI endpoints fall back to local/mock mode) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional infrastructure ---
# Redis connection string; enables the BullMQ queue provider for background jobs
# (knowledge ingestion, etc.). Without it, an in-memory queue is used instead.
REDIS_URL=
# development | testing | staging | production (defaults to NODE_ENV if unset)
DEPLOYMENT_PROFILE=
# Comma-separated list of additional frontend origins allowed by CORS, e.g.
# "https://myblog.com,https://www.myblog.com". localhost, 127.0.0.1, and *.vercel.app
# are always allowed.
ALLOWED_ORIGINS=
